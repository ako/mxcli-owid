-- Stage 6: the OData service the figures fetch from.
--
-- PublishAssociations: Yes selects the "as a link" representation, which is
-- also the default. It does NOT mean "publish every association" — this service
-- exposes no navigation properties at all.
--
-- The trap (mxcli lint MDL-ODATA06): 'No' does not mean "publish no
-- associations", it selects the "associated object id" representation. THAT is
-- what makes mxbuild fail with CE7375, even for a service publishing no
-- associations — and the literal fix CE7375 suggests, publishing the system ID
-- as key, is wrong anyway: object ids are autogenerated and differ per
-- environment, so an id in an external contract breaks on promotion.
--
-- Country name, ISO code and region are still denormalized onto Observation:
-- that is the flat row shape Vega binds to, so it saves a client-side join.
--
-- No authentication: app security is off, so the feeds are anonymous.

CREATE ODATA SERVICE Owid.OwidApi (
  path: 'odata/owid/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Owid.Explorer',
  ServiceName: 'OwidApi',
  PublishAssociations: Yes
)
{
  publish entity Owid.Country as 'Countries' (UsePaging: Yes, PageSize: 300)
    expose (
      Name as 'country' (KEY, Filterable, Sortable),
      Code as 'code',
      IsoNumeric as 'id' (Filterable),
      Region as 'region' (Filterable, Sortable)
    );

  publish entity Owid.Indicator as 'Indicators' (UsePaging: Yes, PageSize: 100)
    expose (
      IndKey as 'key' (KEY, Filterable),
      Label as 'label',
      Unit as 'unit',
      Fmt as 'format',
      Scale as 'scale',
      LowerIsBetter as 'lowerIsBetter',
      SortOrder as 'sortOrder' (Sortable)
    );

  publish entity Owid.Topic as 'Topics' (UsePaging: Yes, PageSize: 100)
    expose (
      TopicId as 'id' (KEY, Filterable),
      Label as 'label',
      Note as 'note',
      XKey as 'x',
      YKey as 'y',
      SortOrder as 'sortOrder' (Sortable)
    );

  -- 13,760 rows. Vega fetches a URL once and never follows @odata.nextLink, so
  -- every figure caps its own request with $filter/$top rather than relying on
  -- the page size. A single-year figure pulls ~215 rows.
  publish entity Owid.Observation as 'Observations' (UsePaging: Yes, PageSize: 20000)
    expose (
      RowKey as 'rowKey' (KEY, Filterable),
      Year as 'year' (Filterable, Sortable),
      CountryName as 'country' (Filterable, Sortable),
      IsoNumeric as 'id' (Filterable),
      Region as 'region' (Filterable, Sortable),
      Pop as 'pop' (Sortable),
      Gdp as 'gdp' (Sortable),
      Le as 'le' (Sortable),
      Cm as 'cm' (Sortable),
      En as 'en' (Sortable),
      Co2 as 'co2' (Sortable),
      Fe as 'fe' (Sortable),
      Kc as 'kc' (Sortable),
      Sc as 'sc' (Sortable)
    );
};
