-- Stage 7: give every published entity a key attribute Mendix will accept.
--
-- An OData entity set needs a key, and Mendix requires that key attribute to
-- carry a unique validation rule (CE: "Add a unique validation rule to
-- attribute X to be able to use it as the key"). MDL cannot add a constraint
-- in place, so each key attribute is dropped and re-added as UNIQUE.
--
-- Observation has no single unique attribute — it is keyed on country AND year
-- — so it gets a synthetic RowKey ('Brazil|2020'), set by RefreshOwidData.
-- Keying on a business value rather than the system ID is deliberate: object
-- ids are autogenerated and differ between environments, so an id in an
-- external contract breaks the moment a consumer is promoted.

ALTER ENTITY Owid.Country DROP ATTRIBUTE IF EXISTS Name;
ALTER ENTITY Owid.Country ADD ATTRIBUTE Name: String(80) NOT NULL UNIQUE
  ERROR 'Country name must be unique.';

ALTER ENTITY Owid.Indicator DROP ATTRIBUTE IF EXISTS IndKey;
ALTER ENTITY Owid.Indicator ADD ATTRIBUTE IndKey: String(10) NOT NULL UNIQUE
  ERROR 'Indicator key must be unique.';

ALTER ENTITY Owid.Topic DROP ATTRIBUTE IF EXISTS TopicId;
ALTER ENTITY Owid.Topic ADD ATTRIBUTE TopicId: String(20) NOT NULL UNIQUE
  ERROR 'Topic id must be unique.';

ALTER ENTITY Owid.Observation ADD ATTRIBUTE IF NOT EXISTS RowKey: String(100) NOT NULL UNIQUE
  ERROR 'Observation must be unique per country and year.';
