-- Stage 27: turning a card's choices into a statement and a spec.
--
-- Both are string building, and both are in Java for the same reason: they are
-- long chains of conditionals over a dozen inputs, and MDL expressions express
-- that badly enough that the bugs would be in the punctuation rather than in
-- the logic. The precedent is BuildChartJson on board one.
--
--
-- WHY THIS IS NOT A SQL INJECTION
--
-- The user picks the columns, so column names reach the statement as text.
-- What makes that safe is not escaping, it is the whitelist: AllowedFields is
-- built from Owid.Field, which is built from DESCRIBE on the file itself, so
-- the only names that can appear are names the parquet actually has. A name
-- that is not in the list is refused and the card says why.
--
-- The one value the user TYPES -- the filter -- never reaches the statement at
-- all. It travels as {filterval}, bound by the connector. So the text a person
-- can author and the SQL are never the same string.

CREATE OR MODIFY JAVA ACTION Owid.CardSql (
  Url:           String NOT NULL,
  ChartType:     String NOT NULL,
  XField:        String,
  YField:        String,
  SeriesField:   String,
  Agg:           String NOT NULL,
  FilterField:   String,
  RowLimit:      Long NOT NULL,
  AllowedFields: String NOT NULL
) RETURNS String
EXPOSED AS 'Build a card statement' IN 'Explorer'
AS $$
java.util.Set<String> ok = new java.util.HashSet<>();
for (String f : AllowedFields.split(",")) {
    String n = f.trim();
    if (!n.isEmpty()) {
        ok.add(n);
    }
}

// A column name is quoted, never escaped-and-hoped: it has already been proved
// to exist by DESCRIBE, and anything else throws rather than reaching DuckDB.
java.util.function.Function<String, String> col = name -> {
    String n = name == null ? "" : name.trim();
    if (n.isEmpty()) {
        throw new com.mendix.systemwideinterfaces.MendixRuntimeException(
                "This chart needs a field that has not been chosen yet.");
    }
    if (!ok.contains(n)) {
        throw new com.mendix.systemwideinterfaces.MendixRuntimeException(
                "'" + n + "' is not a column of this table.");
    }
    return "\"" + n.replace("\"", "\"\"") + "\"";
};

String type = ChartType == null ? "Line" : ChartType;
String agg  = Agg == null ? "NoAgg" : Agg;
boolean aggregated = !"NoAgg".equals(agg);

java.util.function.Function<String, String> value = c -> {
    switch (agg) {
        case "Sum":   return "sum(" + c + ")";
        case "Avg":   return "avg(" + c + ")";
        case "Min":   return "min(" + c + ")";
        case "Max":   return "max(" + c + ")";
        case "Count": return "count(" + c + ")";
        default:      return c;
    }
};

long limit = RowLimit == null || RowLimit <= 0 ? 5000L : Math.min(RowLimit, 50000L);
String from = " FROM read_parquet('" + Url.replace("'", "''") + "')";

// The filter is always present and always inert when empty, which is what lets
// one statement serve the filtered and unfiltered card. Cast to VARCHAR so a
// numeric column and a typed-in year compare as the same thing.
String where = "";
if (FilterField != null && !FilterField.trim().isEmpty()) {
    where = " WHERE ({filterval} = '' OR CAST(" + col.apply(FilterField)
          + " AS VARCHAR) = {filterval})";
}

StringBuilder inner = new StringBuilder();

if ("Number".equals(type)) {
    // No axes at all: one row, one number. Count is the only aggregate that
    // means anything without a column, so it is allowed to have none.
    String y = "Count".equals(agg) && (YField == null || YField.trim().isEmpty())
             ? "count(*)"
             : value.apply(col.apply(YField));
    inner.append("SELECT ").append(y).append(" AS y").append(from).append(where);
} else if ("Heatmap".equals(type)) {
    // Two dimensions and a colour: x across, series down, value in the cell.
    inner.append("SELECT ").append(col.apply(XField)).append(" AS x, ")
         .append(col.apply(SeriesField)).append(" AS s, ")
         .append(value.apply(col.apply(YField))).append(" AS y")
         .append(from).append(where)
         .append(" GROUP BY 1, 2 ORDER BY 1, 2");
} else if ("Scatter".equals(type)) {
    // Aggregated, the split field IS the grain -- one point per country rather
    // than one per country-year, which is the whole reason to aggregate a
    // scatter. Unaggregated it is the raw rows and the split is just colour.
    boolean hasSeries = SeriesField != null && !SeriesField.trim().isEmpty();
    if (aggregated && hasSeries) {
        inner.append("SELECT ").append(col.apply(SeriesField)).append(" AS s, ")
             .append(value.apply(col.apply(XField))).append(" AS x, ")
             .append(value.apply(col.apply(YField))).append(" AS y")
             .append(from).append(where).append(" GROUP BY 1 ORDER BY 1");
    } else {
        inner.append("SELECT ").append(col.apply(XField)).append(" AS x, ")
             .append(col.apply(YField)).append(" AS y");
        if (hasSeries) {
            inner.append(", ").append(col.apply(SeriesField)).append(" AS s");
        }
        inner.append(from).append(where);
    }
} else {
    // Line, Bar, Area: a key across the bottom, a value up the side, and an
    // optional second key that becomes the series.
    boolean hasSeries = SeriesField != null && !SeriesField.trim().isEmpty();
    inner.append("SELECT ").append(col.apply(XField)).append(" AS x");
    if (hasSeries) {
        inner.append(", ").append(col.apply(SeriesField)).append(" AS s");
    }
    inner.append(", ").append(value.apply(col.apply(YField))).append(" AS y")
         .append(from).append(where);
    if (aggregated) {
        inner.append(hasSeries ? " GROUP BY 1, 2" : " GROUP BY 1");
    }
    inner.append(hasSeries ? " ORDER BY 1, 2" : " ORDER BY 1");
}

inner.append(" LIMIT ").append(limit);

// struct_pack over the projected row rather than to_json(t) so the JSON keys
// are x/s/y whatever the columns were called -- the spec is written against
// those three names and never has to know.
String pack = "Scatter".equals(type) || "Line".equals(type) || "Bar".equals(type)
           || "Area".equals(type) || "Heatmap".equals(type)
        ? (inner.indexOf(" AS s") >= 0
              ? "struct_pack(x := t.x, s := t.s, y := t.y)"
              : "struct_pack(x := t.x, y := t.y)")
        : "struct_pack(y := t.y)";

// The distinct series count travels with the data because the spec needs it
// and cannot work it out: a split by country is 200-odd series, and a legend
// with 200 entries is not a legend. CardSpec turns it off above a threshold
// rather than letting Vega truncate it and warn.
String seriesCount = inner.indexOf(" AS s") >= 0 ? "count(DISTINCT t.s)" : "0";
return "SELECT coalesce(to_json(list(" + pack + ")), '[]') AS j, count(*) AS n, "
     + seriesCount + " AS s FROM (" + inner + ") t";
$$;


-- The spec.
--
-- Written against x / s / y and nothing else, because CardSql already renamed
-- the columns to those. The axis titles carry the real field names, so the
-- chart still says what it is about.
CREATE OR MODIFY JAVA ACTION Owid.CardSpec (
  ChartType:   String NOT NULL,
  XField:      String,
  YField:      String,
  SeriesField: String,
  Agg:         String NOT NULL,
  XIsMeasure:  Boolean NOT NULL,
  SeriesCount: Long NOT NULL,
  Height:      Long NOT NULL
) RETURNS String
EXPOSED AS 'Build a card spec' IN 'Explorer'
AS $$
String type = ChartType == null ? "Line" : ChartType;
boolean hasSeries = SeriesField != null && !SeriesField.trim().isEmpty();
String agg = Agg == null ? "NoAgg" : Agg;

java.util.function.Function<String, String> esc = t ->
        t == null ? "" : t.replace("\\", "\\\\").replace("\"", "\\\"");

String yTitle = "Count".equals(agg) && (YField == null || YField.trim().isEmpty())
        ? "count"
        : ("NoAgg".equals(agg) ? esc.apply(YField)
                               : agg.toLowerCase() + " of " + esc.apply(YField));

// The board's palette, so a chart the user assembled still looks like the rest
// of the page rather than like Vega's defaults.
String RANGE = "[\"#1d2d3d\",\"#416180\",\"#597ea3\",\"#749dc4\",\"#94bce3\","
             + "\"#b8712f\",\"#a9a9ad\",\"#6c8fae\",\"#2c4763\",\"#c9a227\"]";
String CONFIG =
    "\"config\":{\"font\":\"Barlow\",\"view\":{\"stroke\":\"transparent\"},"
  + "\"axis\":{\"labelFont\":\"Barlow\",\"labelFontSize\":10,\"labelColor\":\"#6c6f72\","
  + "\"domainColor\":\"#dededf\",\"tickColor\":\"#dededf\",\"gridColor\":\"#ebebec\","
  + "\"titleFont\":\"Barlow Condensed\",\"titleFontSize\":11,\"titleColor\":\"#6c6f72\","
  + "\"titleFontWeight\":400},"
  // symbolLimit is not cosmetic: splitting by country gives 200-odd series and
  // Vega warns and truncates on its own. Capping it says the same thing on
  // purpose, and the chart stays readable.
  + "\"legend\":{\"labelFont\":\"Barlow\",\"labelFontSize\":10,\"labelColor\":\"#6c6f72\","
  + "\"title\":null,\"symbolStrokeWidth\":2,"
  + "\"orient\":\"bottom\",\"direction\":\"horizontal\"},"
  + "\"range\":{\"category\":" + RANGE + ",\"heatmap\":[\"#fcfdfe\",\"#b0cae1\",\"#4f74a0\",\"#0e161d\"]}}";

long h = Height == null || Height <= 0 ? 260L : Height;
StringBuilder b = new StringBuilder();
b.append("{\"$schema\":\"https://vega.github.io/schema/vega-lite/v6.json\",")
 .append("\"data\":{\"name\":\"table\"},\"background\":null,")
 .append("\"width\":\"container\",\"height\":").append(h).append(",")
 .append(CONFIG).append(",");

if ("Number".equals(type)) {
    // A KPI is a text mark, which is the whole chart: one datum, one number,
    // sized to be read from across the room.
    b.append("\"mark\":{\"type\":\"text\",\"font\":\"Barlow Condensed\",\"fontSize\":64,")
     .append("\"fontWeight\":600,\"color\":\"#1d2d3d\",\"align\":\"center\",\"baseline\":\"middle\"},")
     .append("\"encoding\":{\"text\":{\"field\":\"y\",\"type\":\"quantitative\",")
     .append("\"format\":\",.4~s\"}}}");
    return b.toString();
}

// Above a dozen series the legend stops being a key and becomes a wall, so it
// goes away and the card's own caption says how many there were instead.
boolean legend = SeriesCount != null && SeriesCount > 0 && SeriesCount <= 12;
String colour = hasSeries
        ? ("\"color\":{\"field\":\"s\",\"type\":\"nominal\""
           + (legend ? "" : ",\"legend\":null") + "},")
        : "";

if ("Heatmap".equals(type)) {
    b.append("\"mark\":{\"type\":\"rect\"},\"encoding\":{")
     .append("\"x\":{\"field\":\"x\",\"type\":\"nominal\",\"axis\":{\"title\":\"")
     .append(esc.apply(XField)).append("\",\"labelAngle\":0}},")
     .append("\"y\":{\"field\":\"s\",\"type\":\"nominal\",\"axis\":{\"title\":\"")
     .append(esc.apply(SeriesField)).append("\"}},")
     .append("\"color\":{\"field\":\"y\",\"type\":\"quantitative\",\"title\":\"")
     .append(yTitle).append("\"},")
     .append("\"tooltip\":[{\"field\":\"x\"},{\"field\":\"s\"},")
     .append("{\"field\":\"y\",\"type\":\"quantitative\",\"format\":\",.4~g\"}]}}");
    return b.toString();
}

// A bar chart over a text column is categorical; a bar chart over a number --
// a year, an age -- is not, and forcing it to nominal turns 153 years into 153
// tick labels drawn on top of each other. The column decides, not the mark.
String xType = XIsMeasure ? "quantitative" : "nominal";
String mark;
switch (type) {
    case "Bar":     mark = "{\"type\":\"bar\"}"; break;
    case "Area":    mark = "{\"type\":\"area\",\"opacity\":0.85}"; break;
    case "Scatter": mark = "{\"type\":\"circle\",\"size\":60,\"opacity\":0.7}"; break;
    default:        mark = "{\"type\":\"line\",\"strokeWidth\":1.6,\"point\":false}";
}

b.append("\"mark\":").append(mark).append(",\"encoding\":{")
 .append("\"x\":{\"field\":\"x\",\"type\":\"").append(xType).append("\",")
 .append("\"scale\":{\"nice\":false").append("quantitative".equals(xType) ? ",\"zero\":false" : "")
 .append("},\"axis\":{\"title\":\"").append(esc.apply(XField)).append("\"")
 // Categorical axes get as many labels as there are categories unless told
 // otherwise; greedy dropping keeps the ones that fit.
 .append(",\"labelOverlap\":\"greedy\"")
 .append("Bar".equals(type) ? ",\"labelAngle\":0" : "").append("}},")
 .append("\"y\":{\"field\":\"y\",\"type\":\"quantitative\",\"scale\":{\"zero\":")
 .append("Bar".equals(type) || "Area".equals(type) ? "true" : "false")
 .append(",\"nice\":false},\"axis\":{\"title\":\"").append(yTitle).append("\"}},")
 .append(colour)
 .append("\"tooltip\":[{\"field\":\"x\"},")
 .append(hasSeries ? "{\"field\":\"s\"}," : "")
 .append("{\"field\":\"y\",\"type\":\"quantitative\",\"format\":\",.4~g\"}]}}");
return b.toString();
$$;
