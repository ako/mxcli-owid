-- ============================================================================
-- OwidExplorer — proposed model  (PROPOSAL ONLY — not executed)
-- Module: Owid.  Single user, no security.
-- ============================================================================

CREATE MODULE Owid;

-- ---------------------------------------------------------------- enums ----
CREATE ENUMERATION Owid.Region (
  Africa   'Africa',
  Asia     'Asia',
  Americas 'Americas',
  Europe   'Europe',
  Oceania  'Oceania'
);

CREATE ENUMERATION Owid.ScaleType ( Linear 'Linear', Log 'Log' );

-- ----------------------------------------------------- reference data ------
-- All OWID countries that carry data (215 of 276 — the rest are territories
-- with no observations at all). Derived live from OWID's regions table, not
-- seeded: region comes from unnesting each continent's member list, IsoNumeric
-- from resources/iso3166_numeric.csv (OWID publishes no numeric code).
CREATE PERSISTENT ENTITY Owid.Country (
  Name:       String(80) NOT NULL,
  Code:       String(12) NOT NULL,     -- OWID/ISO alpha-3
  IsoNumeric: Integer NOT NULL,        -- joins the choropleth to topojson
  Region:     Enum(Owid.Region) NOT NULL
)
INDEX (Name);

-- The nine series, with the formatting the figures need.
CREATE PERSISTENT ENTITY Owid.Indicator (
  Key:           String(10) NOT NULL,   -- pop, gdp, le, cm, en, co2, fe, kc, sc
  Label:         String(80) NOT NULL,
  Unit:          String(60),
  Format:        String(20),            -- d3 format, e.g. '$,.0f'
  Scale:         Enum(Owid.ScaleType) NOT NULL,
  LowerIsBetter: Boolean DEFAULT false,
  SortOrder:     Integer DEFAULT 0
)
INDEX (Key);

-- The six presets behind the topic switcher.
CREATE PERSISTENT ENTITY Owid.Topic (
  TopicId:   String(20) NOT NULL,
  Label:     String(60) NOT NULL,
  Note:      String(200),
  XKey:      String(10) NOT NULL,   -- indicator key, denormalized (no nav props)
  YKey:      String(10) NOT NULL,
  SortOrder: Integer DEFAULT 0
)
INDEX (TopicId);

-- --------------------------------------------------- observation data ------
-- Wide, not long: one row per country-year carrying all nine values — the
-- exact shape the Vega-Lite specs bind to. 215 x 64 = 13,760 rows.
-- Every measure is nullable: OWID genuinely has no CO2 for 1960 (see
-- FINDINGS.md #8), and a 0 there would read as a real measurement.
--
-- CountryName/IsoNumeric/Region are DENORMALIZED onto the row on purpose. The
-- OData service must publish no association nav properties (CE7375 — see
-- FINDINGS.md #11), and a flat row is what Vega binds to anyway, so the
-- association below exists for model integrity and is never published.
CREATE PERSISTENT ENTITY Owid.Observation (
  Year:        Integer NOT NULL,
  CountryName: String(80) NOT NULL,
  IsoNumeric:  Integer NOT NULL,
  Region:      Enum(Owid.Region) NOT NULL,
  Pop:  Decimal,   -- people
  Gdp:  Decimal,   -- int-$ per capita (Maddison, 2011 PPP)
  Le:   Decimal,   -- years
  Cm:   Decimal,   -- deaths per 1,000 live births
  En:   Decimal,   -- kWh per capita
  Co2:  Decimal,   -- tonnes per capita
  Fe:   Decimal,   -- births per woman
  Kc:   Decimal,   -- kcal per person per day
  Sc:   Decimal    -- mean years of schooling
)
INDEX (Year);

CREATE ASSOCIATION Owid.Observation_Country
  FROM Owid.Observation TO Owid.Country TYPE Reference
  DELETE_BEHAVIOR DeleteBoth;

-- Refresh audit: when the data was last pulled, and whether it worked.
CREATE PERSISTENT ENTITY Owid.RefreshRun (
  StartedAt:   DateTime NOT NULL,
  CompletedAt: DateTime,
  RowsLoaded:  Integer DEFAULT 0,
  Succeeded:   Boolean DEFAULT false,
  Message:     String(500)
);

-- ------------------------------------------------------- view state --------
-- Non-persistable. Backs the header controls; every figure reads it.
CREATE NON_PERSISTENT ENTITY Owid.ViewState (
  Year:        Integer DEFAULT 2023,
  ShowAfrica:  Boolean DEFAULT true,
  ShowAsia:    Boolean DEFAULT true,
  ShowAmericas:Boolean DEFAULT true,
  ShowEurope:  Boolean DEFAULT true,
  ShowOceania: Boolean DEFAULT true,
  LogXAxis:    Boolean DEFAULT true,
  ShowTrail:   Boolean DEFAULT true,
  Playing:     Boolean DEFAULT false
);

CREATE ASSOCIATION Owid.ViewState_Topic
  FROM Owid.ViewState TO Owid.Topic TYPE Reference;
CREATE ASSOCIATION Owid.ViewState_FocusCountry
  FROM Owid.ViewState TO Owid.Country TYPE Reference;

-- -------------------------------------------------------- constants --------
CREATE CONSTANT Owid.CatalogBaseUrl: String
  DEFAULT 'https://catalog.ourworldindata.org/'
  COMMENT 'OWID parquet catalog root; DuckDB httpfs reads from here.';
CREATE CONSTANT Owid.YearFrom: Integer DEFAULT 1960;
CREATE CONSTANT Owid.YearTo:   Integer DEFAULT 2023;

-- ------------------------------------------------- DuckDB ingestion --------
-- Non-persistable carrier: the Java action returns these, a microflow
-- persists them. Keeps the Java thin and the load inspectable.
CREATE NON_PERSISTENT ENTITY Owid.FetchedRow (
  CountryName: String(80), Code: String(12), IsoNumeric: Integer,
  RegionName: String(20), Year: Integer,
  Pop: Decimal, Gdp: Decimal, Le: Decimal, Cm: Decimal, En: Decimal,
  Co2: Decimal, Fe: Decimal, Kc: Decimal, Sc: Decimal
);

-- Opens an in-process DuckDB over JDBC, LOADs httpfs, runs the harmonized
-- nine-source query against the OWID parquet catalog, returns the rows.
-- (Driver jar in userlib/; ~8.5s cold — see FINDINGS.md #7.)
CREATE JAVA ACTION Owid.FetchOwidRows (
  baseUrl:  String,
  yearFrom: Integer,
  yearTo:   Integer
) RETURNS List<Owid.FetchedRow>;

CREATE MICROFLOW Owid.ACT_RefreshFromOwid;   -- fetch -> replace Observations -> log RefreshRun
CREATE MICROFLOW Owid.ASU_Seed;              -- seed Country/Indicator/Topic; refresh if empty
CREATE MICROFLOW Owid.DS_Observations;       -- ViewState -> filtered Observation list
CREATE MICROFLOW Owid.DS_ViewState;          -- create + default the ViewState

-- ------------------------------------------------------------ OData --------
-- What the figures fetch. No authentication: app security is off.
CREATE ODATA SERVICE Owid.OwidApi (
  path: 'odata/owid/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Owid.Explorer',
  ServiceName: 'OwidApi',
  PublishAssociations: No          -- deliberate: no nav props, no CE7375
)
{
  publish entity Owid.Country as 'Countries' (UsePaging: Yes, PageSize: 300)
    expose ( Name as 'country' (KEY, Filterable, Sortable),
             Code as 'code', IsoNumeric as 'id' (Filterable),
             Region as 'region' (Filterable, Sortable) );

  publish entity Owid.Indicator as 'Indicators' (UsePaging: Yes, PageSize: 100)
    expose ( Key as 'key' (KEY, Filterable), Label as 'label', Unit as 'unit',
             Format as 'format', Scale as 'scale', LowerIsBetter as 'lowerIsBetter' );

  -- XKey/YKey are the indicator keys, denormalized for the same reason.
  publish entity Owid.Topic as 'Topics' (UsePaging: Yes, PageSize: 100)
    expose ( TopicId as 'id' (KEY, Filterable), Label as 'label', Note as 'note',
             XKey as 'x', YKey as 'y' );

  -- 13,760 rows. Vega fetches once and never follows @odata.nextLink, so every
  -- figure must cap its own request with $filter/$top rather than rely on the
  -- page size (FINDINGS.md #12). Single-year figures pull ~215 rows.
  publish entity Owid.Observation as 'Observations' (UsePaging: Yes, PageSize: 20000)
    expose ( Year as 'year' (KEY, Filterable, Sortable),
             CountryName as 'country' (Filterable, Sortable),
             IsoNumeric as 'id' (Filterable),
             Region as 'region' (Filterable, Sortable),
             Pop as 'pop', Gdp as 'gdp', Le as 'le', Cm as 'cm', En as 'en',
             Co2 as 'co2', Fe as 'fe', Kc as 'kc', Sc as 'sc' );

  publish microflow Owid.ACT_RefreshFromOwid as 'Refresh';
};

-- ------------------------------------------------------------- pages -------
CREATE PAGE Owid.Dashboard;   -- the whole mockup, one page (see note below)

SET HOMEPAGE Owid.Dashboard;
